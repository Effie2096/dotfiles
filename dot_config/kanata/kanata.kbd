(defsrc
  esc 1   2   3   4   5   6   7   8   9   0   -      =     bspc
  tab  q   w   e   r   t   y   u   i   o   p   [      ]     \
  caps  a   s   d   f   g   h   j   k   l   ;   '      ret
  lsft   z   x   c   v   b   n   m   ,   .   /   rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(deflayer (canary icon ./icons/keyboard_pink.png)
  @lay  w    l    y  p      b     XX     z      f   o    u     '  XX  XX
  XX   c    r    s  t      g     XX     m      n   e    i     a   XX  XX
  XX  q    j    v  d      k     XX     x      h   ,    .     ;    XX
  XX   XX   XX  @num spc @sym @magic @nav rpt XX @np  XX
  XX XX XX           XX            XX XX XX
)

(deflayer (qwerty icon ./icons/keyboard_yellow.png)
 @lay q  w  e  r    t   XX     y        u   i   o   p  '   bspc
 XX    a  s  d  f    g   XX     h        j   k   l   ;  XX XX
 XX    z  x  c  v    b   XX     n        m   ,   .   ;  XX
  XX   XX   XX  @num spc @sym @magic @nav rpt XX @np  XX
  XX XX XX           XX            XX XX XX
)

(defalias
  esclay (tap-hold $tt $ht esc @lay)
)
(deflayer (source icon ./icons/keyboard.png)
  @esclay  @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr
  @sr      @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr
  @sr      @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr
  @sr      @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr
  @sr      @sr    @sr              @sr               @sr    @sr    @sr
)

(deflayer layers
  _    @can @qwr @src _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _              _              _    _    _
)

(deflayer (navigation icon ./icons/keyboard_green.png)
  XX esc    _      _      _      _   XX  home pgdn   pgup end   del     XX XX
  XX @tlmet @tlalt @tlctl @tlsft _   XX  lft  down   up   right XX      XX XX
  XX XX     XX     XX     XX     _   XX  ret  bspc   XX   XX    XX      XX
  XX XX    XX    _     tab _  _  _    _      XX    XX    XX
  XX XX XX           XX            XX XX XX
)

(deflayer (numbers icon ./icons/keyboard_orange.png)
  XX XX     _      _      _      _   XX  =  7 8 9 +   XX XX
  XX @tlmet @tlalt @tlctl @tlsft .   XX  @* 4 5 6 -   XX XX
  XX XX     _      spc    bspc   ret XX  0  1 2 3 /   XX
  XX XX     XX     _     _     _  _  _    _      XX    XX     XX
  XX XX XX           XX            XX XX XX
)

(deflayer (symbols icon ./icons/keyboard_blue.png)
  XX @!     @@     @#     @$     @%   XX   @&   =      +      -      @_      XX XX
  XX @tlmet @tlalt @tlctl @tlsft @^   XX   @*   @tlp   @t{    @t[    @?      XX XX
  XX @|     \      spc    bspc   ret  XX   @~   @trp   @t}    @t]    /       XX
  XX  XX   XX  _   _       _      _     _    _      XX       XX      XX
  _  _  _     _     _  _  _
)

(deflayer (function icon ./icons/keyboard_mauve.png)
  XX prev   voldwn volu   next    pp XX  prnt  f7 f8 f9 f12     XX XX
  XX @tlmet @tlalt @tlctl @tlsft  _  XX  _     f4 f5 f6 f11     XX XX
  XX _    _    _    _             _  XX  _     f1 f2 f3 f10     XX
  XX XX    XX    _     _     _  _  _  _     XX     XX     XX
  XX XX XX           XX            XX XX XX
)

(deflayer numpad
  _  kp+ kp7 kp8 kp9 kp* XX   XX   XX     XX     XX     XX       XX XX
  XX kp0 kp4 kp5 kp6 kp. XX   XX   @trsft @trctl @tralt @trmet   XX XX
  XX kp- kp1 kp2 kp3 kp/ XX   XX   XX     XX     XX     XX       XX
  XX _   _   _   _   _   _  _  _  _  @can _
  XX XX XX           XX           XX XX XX
)

