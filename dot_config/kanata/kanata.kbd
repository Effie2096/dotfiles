(defcfg
	process-unmapped-keys yes
  tray-icon "./kanata.ico"
  tooltip-layer-changes   	yes  	;;|false|
  tooltip-show-blank      	yes  	;;|no|
  tooltip-duration        	500  	;;|500|
  tooltip-size            	24,24	;;|24 24|
  notify-cfg-reload       	yes  	;;|yes|
  notify-cfg-reload-silent	no   	;;|no|
  notify-error            	yes  	;;|yes|
)

(defvar
  tap-repress-timeout   100
  hold-timeout  200
  tt $tap-repress-timeout
  ht $hold-timeout
)

(defalias
  magic (switch
    ((key-history a 1)) (macro ') break
    ((key-history b 1)) (macro g) break
    ((key-history c 1)) (macro q) break
    ((key-history d 1)) (macro t) break
    ((key-history e 1)) (macro o) break
    ((key-history f 1)) (macro n) break
    ((key-history g 1)) (macro b) break
    ((key-history h 1)) (macro n) break
    ((key-history i 1)) (macro u) break
    ((key-history j 1)) (macro r) break
    ((key-history k 1)) (macro g) break
    ((key-history l 1)) (macro r) break
    ((key-history m 1)) (macro x) break
    ((key-history n 1)) (macro f) break
    ((key-history o 1)) (macro e) break
    ((key-history p 1)) (macro t) break

    ((key-history q 1)) (macro c) break
    ((key-history r 1)) (macro l) break
    ((key-history s 1)) (macro y) break
    ((key-history t 1)) (macro p) break
    ((key-history u 1)) (macro i) break
    ((key-history v 1)) (macro y) break
    ((key-history w 1)) (macro c) break
    ((key-history x 1)) (macro m) break
    ((key-history y 1)) (macro s) break
    ((key-history z 1)) (macro m) break

    ;;((key-history / 1)) (macro --) break
    ((key-history - 1)) (macro S-.) break
    ((key-history = 1)) (macro S-.) break
    ((or
      (key-history spc 1)
      (key-history ret 1)
    )) (macro t h e) break
    ((key-history 0 1)) (macro ;) break
		((key-history 9 1)) (macro S-') break
  )
)

(defalias
  np (layer-switch numpad)
  sr use-defsrc

  can (layer-switch canary)
  qwr (layer-switch qwerty)
  src (layer-switch source)
  lay (layer-toggle layers)
)

(defalias
	tlmet (one-shot 2000 lmet)
	tlalt (one-shot 2000 lalt)
	tlctl (one-shot 2000 lctl)
	tlsft (one-shot 2000 lsft)
	trmet (one-shot 2000 rmet)
	tralt (one-shot 2000 ralt)
	trctl (one-shot 2000 rctl)
	trsft (one-shot 2000 rsft)
)

(defalias
  chr (chord shifty r)
  chs (chord shifty s)
  che (chord shifty e)
  chi (chord shifty i)
)
(defchords shifty 50
  (r        ) r
  (  s      ) s
  (      e  ) e
  (        i) i
  (r s      ) (one-shot 500 lsft)
  (      e i) (one-shot 500 rsft)
)

(defalias
  chnav (chord raise nav)
  chsym (chord raise sym)
)
(defchords raise 15
  (nav) (layer-while-held navigation)
  (sym) (layer-while-held symbols)
  (nav sym) (layer-while-held raise)
)

(defsrc
  esc 1   2   3   4   5   6   7   8   9   0   -      =     bspc
  tab  q   w   e   r   t   y   u   i   o   p   [      ]     \
  caps  a   s   d   f   g   h   j   k   l   ;   '      ret
  lsft   z   x   c   v   b   n   m   ,   .   /   rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(deflayer (canary icon ./icons/keyboard_pink.png)
  @lay w    l    y  p      b   XX     z      f   o  u    '    del XX
  [   c @chr @chs  t      g   XX     m      n   @che  @chi a ]  XX
  ,   q    j    v  d      k   XX     x      h   @lp  @rp    ;    .
  XX   XX   XX   XX @chnav spc @magic @chsym rpt XX @np  XX
  XX XX XX           XX            XX XX XX
)

(deflayer (qwerty icon ./icons/keyboard_yellow.png)
 @lay q  w  e  r    t   XX     y        u   i   o   p  '   del
 XX    a  s  d  f    g   XX     h        j   k   l   ;  XX XX
 XX    z  x  c  v    b   XX     n        m   ,   .   ;  XX
  XX    XX  XX  XX @chnav spc  @magic  @chsym  rpt XX   @np  XX
  XX XX XX           XX            XX XX XX
)

(defalias
  esclay (tap-hold $tt $ht esc @lay)
)
(deflayer (source icon ./icons/keyboard.png)
  @esclay  @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr
  @sr      @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr
  @sr      @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr
  @sr      @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr
  @sr      @sr    @sr              @sr               @sr    @sr    @sr
)

(deflayer layers
  _    @can @qwr @src _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _              _              _    _    _
)

;; Direct access to symbols
(defalias
  exc S-1
  at S-2
  oct S-3
  dol S-4
  per S-5
  hat S-6
  amp S-7
  ast S-8
  lp S-9
  rp S-0
  und S--
  pipe S-\
  til S-grv
  lbrc S-[
  rbrc S-]
  qm S-/
)

(deflayer (navigation icon ./icons/keyboard_green.png)
	_  XX    XX    XX    XX    XX XX home pgdn   pgup end   bspc XX XX
	XX @tlmet @tlalt @tlctl @tlsft XX XX lft  down   up   right ret  XX XX
	XX XX    XX    XX    XX    XX XX prev voldwn volu next  pp   XX
	XX _     _     _     _     _  _  _    _      _    _     _
  XX XX XX           XX            XX XX XX
)

(deflayer (symbols icon ./icons/keyboard_blue.png)
  _  esc _    @lbrc _     grv      XX      @til _      @rbrc   _          _      _  _
  _  +   @und =     @per  @ast     XX      @hat @trsft @trctl  @tralt     @trmet _  _
  _  -   @at  @amp  @pipe \        XX      /    @exc   @oct    @dol       @qm    _
  _  _   _    _     _     tab      _       _    _      _       _          _
  _  _  _     _     _  _  _
)

(deflayer (raise icon ./icons/keyboard_mauve.png)
	_  1     2     3     4     5  XX 6  7     8     9     0     _ _
	_  @tlmet @tlalt @tlctl @tlsft f6 XX f7 @trsft @trctl @tralt @trmet _ _
	_  f1    f2    f4    f4    f5 XX f8 f9    f10   f11   f12   _
	XX _     _     _     _     _  _  _  _     _     _     _
  XX XX XX           XX            XX XX XX
)

(deflayer (numpad icon ./icons/keyboard_orange.png)
	_  kp+ kp7 kp8 kp9 kp* XX XX XX XX XX   XX XX XX
	XX kp0 kp4 kp5 kp6 kp. XX XX XX XX XX   XX XX XX
	XX kp- kp1 kp2 kp3 kp/ XX XX XX XX XX   XX XX
	XX _   _   _   _   _   _  _  _  _  @can _
  XX XX XX           XX           XX XX XX
)

