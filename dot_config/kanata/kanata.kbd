(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
  chords-v2-min-idle 5
  movemouse-smooth-diagonals yes

  tray-icon "./kanata.ico"
  tooltip-layer-changes   	false  	;;|false|
  tooltip-show-blank      	yes  	;;|no|
  tooltip-duration        	500  	;;|500|
  tooltip-size            	24,24	;;|24 24|
  notify-cfg-reload       	yes  	;;|yes|
  notify-cfg-reload-silent	no   	;;|no|
  notify-error            	yes  	;;|yes|
)

(defvar
  tap-repress-timeout   100
  hold-timeout  200
  tt $tap-repress-timeout
  ht $hold-timeout
)

;; Direct access to symbols
(defalias
  ! S-1
  @ S-2
  # S-3
  $ S-4
  % S-5
  ^ S-6
  & S-7
  * S-8
  lp S-9
  rp S-0
  _ S--
  | S-\
  ~ S-grv
  { S-[
  } S-]
  ? S-/
)

(defalias
  magic (switch
    ((key-history ' 1)) (macro a) break
    ((key-history a 1)) (macro ') break
    ((key-history b 1)) (macro g) break
    ((key-history c 1)) (macro q) break
    ((key-history d 1)) (macro t) break
    ((key-history e 1)) (macro o) break
    ((key-history f 1)) (macro n) break
    ((key-history g 1)) (macro b) break
    ((key-history h 1)) (macro n) break
    ((key-history i 1)) (macro u) break
    ((key-history j 1)) (macro r) break
    ((key-history k 1)) (macro g) break
    ((key-history l 1)) (macro r) break
    ((key-history m 1)) (macro x) break
    ((key-history n 1)) (macro f) break
    ((key-history o 1)) (macro e) break
    ((key-history p 1)) (macro t) break

    ((key-history q 1)) (macro c) break
    ((key-history r 1)) (macro l) break
    ((key-history s 1)) (macro y) break
    ((key-history t 1)) (macro p) break
    ((key-history u 1)) (macro i) break
    ((key-history v 1)) (macro y) break
    ((key-history w 1)) (macro c) break
    ((key-history x 1)) (macro m) break
    ((key-history y 1)) (macro s) break
    ((key-history z 1)) (macro m) break

    ;;((key-history / 1)) (macro --) break
    ((key-history - 1)) (macro S-.) break
    ((key-history = 1)) (macro S-.) break
    ((or
      (key-history spc 1)
      (key-history ret 1)
    )) (macro t h e) break
    ((key-history 0 1)) (macro ;) break
		((key-history 9 1)) (macro S-') break
  )
)

(defalias
  sr use-defsrc

  spcm (tap-hold $tt $ht spc (layer-while-held mouse))

  src (layer-switch source)
  can (layer-switch canary)
  qwr (layer-switch qwerty)

  nav (layer-while-held navigation)
  sym (layer-while-held symbols)
  num (layer-while-held numbers)

  np (layer-switch numpad)

  lay (layer-toggle layers)
)

(defalias
  tlmet (one-shot 2000 lmet)
  tlalt (one-shot 2000 lalt)
  tlctl (one-shot 2000 lctl)
  tlsft (one-shot 2000 lsft)
  trmet (one-shot 2000 rmet)
  tralt (one-shot 2000 ralt)
  trctl (one-shot 2000 rctl)
  trsft (one-shot 2000 rsft)
)

(defvirtualkeys
  vk_sft lsft
  vk_cw (caps-word 2000)
)

(defalias
  v-sft (multi (on-press press-vkey vk_sft) (on-release release-vkey vk_sft))
  v-cw (multi (on-press press-vkey vk_cw) (on-release release-vkey vk_cw))
  sft_caps (one-shot 2000 lsft)
)

(deftemplate modcho (keys timeout action)
  $keys $action $timeout all-released (navigation symbols numbers function numpad mouse)
)

(defchordsv2
  (t! modcho (q w            ) 30 (one-shot 2000 lctl))
  (t! modcho (  w e          ) 30 @sft_caps)
  (t! modcho (    e r        ) 30 (one-shot 2000 lalt))
  (t! modcho (  w   r        ) 20 (one-shot 2000 lmet))
  (t! modcho (        i   p  ) 20 (one-shot 2000 lmet))
  (t! modcho (        i o    ) 30 (one-shot 2000 lalt))
  (t! modcho (          o p  ) 30 @sft_caps)
  (t! modcho (            p [) 30 (one-shot 2000 lctl))

  (t! modcho (1 2    ) 30 @{)
  (t! modcho (  2 3  ) 20 [)
  (t! modcho (    3 4) 40 @lp)
  (t! modcho (8 9    ) 30 @rp)
  (t! modcho (  9 0  ) 20 ])
  (t! modcho (    0 -) 30 @})

  ;; H diagraphs
  (r i) (macro t h) 200 first-release (navigation symbols numbers function numpad mouse)
  (q i) (macro c h) 200 first-release (navigation symbols numbers function numpad mouse)
  (1 i) (macro w h) 200 first-release (navigation symbols numbers function numpad mouse)
  (e i) (macro s h) 200 first-release (navigation symbols numbers function numpad mouse)
  (t i) (macro g h) 200 first-release (navigation symbols numbers function numpad mouse)
  (4 i) (macro p h) 200 first-release (navigation symbols numbers function numpad mouse)

  (b m) (layer-while-held function) 40 first-release (navigation symbols numbers function numpad mouse)
)

(defsrc
  esc 1   2   3   4   5   6   7   8   9   0   -      =     bspc
  tab  q   w   e   r   t   y   u   i   o   p   [      ]     \
  caps  a   s   d   f   g   h   j   k   l   ;   '      ret
  lsft   z   x   c   v   b   n   m   ,   .   /   rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(deflayer (canary icon ./icons/keyboard_pink.png)
  @lay  w    l    y  p      b     XX     z      f   o    u     '  XX  XX
  XX   c    r    s  t      g     XX     m      n   e    i     a   XX  XX
  XX  q    j    v  d      k     XX     x      h   ,    .     ;    XX
  XX   XX   XX  @num @spcm @sym @magic @nav rpt XX @np  XX
  XX XX XX           XX            XX XX XX 
)

(deflayer (qwerty icon ./icons/keyboard_yellow.png)
  @lay  q  w  e  r    t   XX     y        u   i   o   p   XX XX
  XX    a  s  d  f    g   XX     h        j   k   l   ;  XX XX
  XX    z  x  c  v    b   XX     n        m   ,   .   '  XX
  XX   XX   XX  @num @spcm @sym @magic @nav rpt XX @np  XX
  XX XX XX           XX            XX XX XX
)

(defalias
  esclay (tap-hold $tt $ht esc @lay)
)
(deflayer (source icon ./icons/keyboard.png)
  @esclay  @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr
  @sr      @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr
  @sr      @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr
  @sr      @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr    @sr
  @sr      @sr    @sr              @sr               @sr    @sr    @sr
)

(deflayer layers
  _    @can @qwr @src _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _              _              _    _    _
)

(deflayer (navigation icon ./icons/keyboard_green.png)
  XX esc    _      _      _      _   XX  home pgdn   pgup end   del     XX XX
  XX @tlmet @tlalt @tlctl @tlsft _   XX  lft  down   up   right XX      XX XX
  XX XX     XX     XX     XX     _   XX  ret  spc    bspc XX    XX      XX
  XX XX    XX    _     tab _  _  _    _      XX    XX    XX
  XX XX XX           XX            XX XX XX
)

(deflayer (numbers icon ./icons/keyboard_orange.png)
  XX XX     _      _      _      @%  XX  =  7 8 9 +   XX XX
  XX @tlmet @tlalt @tlctl @tlsft .   XX  @* 4 5 6 -   XX XX
  XX XX     _      bspc   spc    ret XX  0  1 2 3 /   XX
  XX XX     XX     _     _     _  _  _    _      XX    XX     XX
  XX XX XX           XX            XX XX XX
)

(deflayer (symbols icon ./icons/keyboard_blue.png)
  XX @!     @@     @#     @$     @%   XX   @&   =       +       -       @_      XX XX
  XX @tlmet @tlalt @tlctl @tlsft @^   XX   @*   @tlsft  @tlctl  @tlalt  @tlmet  XX XX
  XX \      @|    bspc   spc    ret  XX   @~   grv     XX      @?      /       XX
  XX  XX   XX  _   _       _      _     _    _      XX       XX      XX
  _  _  _     _     _  _  _
)

(deflayer (function icon ./icons/keyboard_mauve.png)
  XX voldwn volu   prev   next    pp XX  prnt  f7 f8 f9 f12     XX XX
  XX @tlmet @tlalt @tlctl @tlsft  XX  XX  XX     f4 f5 f6 f11     XX XX
  XX XX    XX    XX    XX             XX  XX  XX     f1 f2 f3 f10     XX
  XX XX    XX    _     _     _  _  _  _     XX     XX     XX
  XX XX XX           XX            XX XX XX
)

(deflayer numpad
  _  kp+ kp7 kp8 kp9 kp* XX   XX   XX     XX     XX     XX       XX XX
  XX kp0 kp4 kp5 kp6 kp. XX   XX   @tlsft @tlctl @tlalt @tlmet   XX XX
  XX kp- kp1 kp2 kp3 kp/ XX   ret  spc    bspc     XX     XX       XX
  XX XX   XX   _   _   _   _  _  _  XX  @can XX
  XX XX XX           XX           XX XX XX
)

(defvar
  mw-initial-v 10
  mw-maximum-v 60
  mw-accel 1.15
  mw-decel 0.93)
(defalias
  lmo (tap-hold $tt $ht mltp mlft)
  rmo (tap-hold $tt $ht mrtp mrgt)
  mmo (tap-hold $tt $ht mmtp mmid)

  msl (movemouse-accel-left  2 1 4 4)
  msd (movemouse-accel-down  2 1 4 4)
  msu (movemouse-accel-up    2 1 4 4)
  msr (movemouse-accel-right 2 1 4 4)

  mwu (mwheel-accel-up $mw-initial-v $mw-maximum-v $mw-accel $mw-decel)
  mwd (mwheel-accel-down $mw-initial-v $mw-maximum-v $mw-accel $mw-decel)
  mwl (mwheel-left 50 120)
  mwr (mwheel-right 50 120)

  mfst (movemouse-speed 25)
)
(deflayer (mouse icon ./icons/keyboard_orange.png)
  _   XX     XX     XX     XX     XX  XX   XX    XX    @mwl @mwr   XX    XX XX
  XX  @tlmet @tlalt @tlctl @tlsft XX  XX   @msl  @msd  @msu @msr   @mwu  XX XX
  XX  XX     XX     XX     @mfst  XX  XX   ret   spc   bspc   XX   @mwd  XX
  XX  XX     XX     XX     _      XX  @mmo @lmo  @rmo _    @can _
  XX XX XX           XX           XX XX XX
)
