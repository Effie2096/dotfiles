{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"logo": {
		"type": "file",
		"source": "~/.config/fastfetch/eeby_fox.txt",
		"width": 34,
		"height": 6,
		"position": "left",
		"printRemaining": true,
		"padding": {
			"top": 0,
			"right": 6,
			"left": 1
		},
		"color": {
			"1": "38;5;202",
			"2": "38;5;15",
			"3": "38;5;94",
			"4": "38;5;0"
		}
	},
	"display": {
		"constants": ["  "]
	},
	"modules": [
		// "break",
		{
			"type": "custom",
			"key": "let fox: Host",
			"keyColor": "38;5;202",
			"format": "= {"
		},
		{
			"key": "{$1}distro",
			"keyColor": "38;5;202",
			"type": "os",
			"format": "\"{name}\","
		},
		{
			"key": "{$1}wm",
			"keyColor": "38;5;202",
			"type": "command",
			"text": "komorebi --version | head -1",
			"format": "\"{1}\","
		},
		{
			"key": "{$1}cursor",
			"keyColor": "38;5;202",
			"type": "cursor",
			"format": "\"{1}\","
		},
		{
			"key": "{$1}term",
			"keyColor": "38;5;202",
			"format": "\"{pretty-name}\",",
			"type": "terminal"
		},
		{
			"key": "{$1}theme",
			"keyColor": "38;5;202",
			"type": "terminaltheme",
			"format": "\"{fg-color} - {bg-color}\","
		},
		{
			"key": "{$1}font",
			"keyColor": "38;5;202",
			"type": "terminalfont",
			"format": "\"{name}\","
		},
		{
			"key": "{$1}shell",
			"keyColor": "38;5;202",
			"type": "shell",
			"format": "\"{pretty-name}\","
		},
		{
			"key": "{$1}packages",
			"keyColor": "38;5;202",
			"type": "packages",
			"format": "{all},"
		},
		{
			"key": "{$1}editor",
			"keyColor": "38;5;202",
			"type": "editor",
			"format": "\"{name}\","
		},
		{
			"key": "{$1}cpu",
			"keyColor": "38;5;202",
			"type": "cpu",
			"format": "\"{name}\","
		},
		{
			"key": "{$1}gpu",
			"keyColor": "38;5;202",
			"type": "gpu",
			"format": "\"{name}\","
		},
		{
			"type": "custom",
			"format": "};"
		},
		"break",
		{
			"key": " ",
			"type": "colors",
			"symbol": "background"
		}
	]
}
