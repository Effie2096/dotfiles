(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
  chords-v2-min-idle 5
  movemouse-smooth-diagonals yes

  tray-icon "./kanata.ico"
  tooltip-layer-changes   	yes  	;;|false|
  tooltip-show-blank      	yes  	;;|no|
  tooltip-duration        	500  	;;|500|
  tooltip-size            	24,24	;;|24 24|
  notify-cfg-reload       	yes  	;;|yes|
  notify-cfg-reload-silent	no   	;;|no|
  notify-error            	yes  	;;|yes|
)

(defvar
  tap-repress-timeout   100
  hold-timeout  200
  tt $tap-repress-timeout
  ht $hold-timeout
)

;; Direct access to symbols
(defalias
  ! S-1
  @ S-2
  # S-3
  $ S-4
  % S-5
  ^ S-6
  & S-7
  * S-8
  lp S-9
  rp S-0
  _ S--
  | S-\
  ~ S-grv
  { S-[
  } S-]
  ? S-/
)

(defalias
  magic (switch
    ((key-history ' 1)) (macro a) break
    ((key-history a 1)) (macro ') break
    ((key-history b 1)) (macro g) break
    ((key-history c 1)) (macro q) break
    ((key-history d 1)) (macro t) break
    ((key-history e 1)) (macro o) break
    ((key-history f 1)) (macro n) break
    ((key-history g 1)) (macro b) break
    ((key-history h 1)) (macro n) break
    ((key-history i 1)) (macro u) break
    ((key-history j 1)) (macro r) break
    ((key-history k 1)) (macro g) break
    ((key-history l 1)) (macro r) break
    ((key-history m 1)) (macro x) break
    ((key-history n 1)) (macro f) break
    ((key-history o 1)) (macro e) break
    ((key-history p 1)) (macro t) break

    ((key-history q 1)) (macro c) break
    ((key-history r 1)) (macro l) break
    ((key-history s 1)) (macro y) break
    ((key-history t 1)) (macro p) break
    ((key-history u 1)) (macro i) break
    ((key-history v 1)) (macro y) break
    ((key-history w 1)) (macro c) break
    ((key-history x 1)) (macro m) break
    ((key-history y 1)) (macro s) break
    ((key-history z 1)) (macro m) break

    ;;((key-history / 1)) (macro --) break
    ((key-history - 1)) (macro S-.) break
    ((key-history = 1)) (macro S-.) break
    ((or
      (key-history spc 1)
      (key-history ret 1)
    )) (macro t h e) break
    ((key-history 0 1)) (macro ;) break
		((key-history 9 1)) (macro S-') break
  )
)

(defalias
  sr use-defsrc

  ;; escm (tap-hold $tt $ht esc (layer-while-held mouse))

  src (layer-switch source)
  can (layer-switch canary)
  qwr (layer-switch qwerty)

  nav (layer-while-held navigation)
  sym (layer-while-held symbols)
  num (layer-while-held numbers)

  np (layer-switch numpad)

  lay (layer-toggle layers)
)

(defalias
  tlmet (one-shot 2000 lmet)
  tlalt (one-shot 2000 lalt)
  tlctl (one-shot 2000 lctl)
  tlsft (one-shot 2000 lsft)
  trmet (one-shot 2000 rmet)
  tralt (one-shot 2000 ralt)
  trctl (one-shot 2000 rctl)
  trsft (one-shot 2000 rsft)
)

(defalias
  t[  (tap-hold $tt $tt [   (macro [ ]))         
  t{  (tap-hold $tt $tt @{  (macro @{ @}))       
  tlp (tap-hold $tt $tt @lp (macro @lp @rp))     
  trp (tap-hold $tt $tt @rp (macro @lp @rp lft)) 
  t}  (tap-hold $tt $tt @}  (macro @{ @} lft))   
  t]  (tap-hold $tt $tt ]   (macro [ ] lft))     
)

(defchordsv2
  (q w          ) (one-shot 500 lctl) 250 first-release (qwerty navigation symbols numbers function numpad)
  (  w e        ) (one-shot 500 lsft) 250 first-release (qwerty navigation symbols numbers function numpad)
  (        o p  ) (one-shot 500 rsft) 250 first-release (qwerty navigation symbols numbers function numpad)
  (          p [) (one-shot 500 rctl) 250 first-release (qwerty navigation symbols numbers function numpad)


  (1 2    ) @t[  40 first-release (qwerty navigation symbols numbers function numpad)
  (  2 3  ) @t{  40 first-release (qwerty navigation symbols numbers function numpad)
  (    3 4) @tlp 40 first-release (qwerty navigation symbols numbers function numpad)
  (8 9    ) @trp 40 first-release (qwerty navigation symbols numbers function numpad)
  (  9 0  ) @t}  40 first-release (qwerty navigation symbols numbers function numpad)
  (    0 -) @t[  40 first-release (qwerty navigation symbols numbers function numpad)

  ;; H diagraphs
  (r o) (macro t h) 40 first-release (qwerty navigation symbols numbers function numpad)
  (q o) (macro c h) 40 first-release (qwerty navigation symbols numbers function numpad)
  (1 o) (macro w h) 40 first-release (qwerty navigation symbols numbers function numpad)
  (e o) (macro s h) 40 first-release (qwerty navigation symbols numbers function numpad)
  (t o) (macro g h) 40 first-release (qwerty navigation symbols numbers function numpad)
  (4 o) (macro p h) 40 first-release (qwerty navigation symbols numbers function numpad)

  (b m) (layer-while-held function) 40 first-release (qwerty navigation symbols numbers function numpad)
)


