workspace "1" { }
workspace "2" { }
workspace "3" { }
workspace "4" { }
workspace "5" { }
workspace "6" { }
workspace "7" { }
workspace "8" { }
workspace "9" { }
workspace "10" { }

window-rule {
    geometry-corner-radius 0
    focus-ring {
        on
        width 4
    }
    clip-to-geometry true
    default-column-width { proportion 1.0; }
}

layer-rule {
    match namespace="^noctalia-wallpaper*"
    place-within-backdrop true
}

// if you use steam you will probably like these
window-rule {
    match app-id="steam"
    open-on-workspace "9"
}
window-rule {
    match app-id="steam"
    exclude title=r#"^[Ss]team$"#
    open-floating true
}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}

window-rule {
    match app-id="neovide"
    opacity 0.95
}

window-rule {
    match app-id="Spotify"
    open-on-workspace "7"
}

window-rule {
    match app-id="vesktop"
    open-on-workspace "8"
}
